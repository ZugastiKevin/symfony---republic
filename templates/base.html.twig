<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Spectral:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header id="header">
            <nav class="navbar">
                <!-- Logo avec drapeau français -->
                <div class="navbar-logo">
                    <a href="{{ path('home') }}" class="logo-link">
                        <div id="french-flag" class="french-flag logo-flag">
                            <div class="flag-stripe flag-stripe--blue"></div>
                            <div class="flag-stripe flag-stripe--white"></div>
                            <div class="flag-stripe flag-stripe--red"></div>
                        </div>
                        <span class="logo-text" data-i18n="nav_home">République</span>
                    </a>
                </div>
                
                <!-- Navigation principale -->
                <ul class="links-container">
                    <li class="nav-items"><a href="{{ path('mini_games')}}" data-i18n="nav_minigames">Je teste mes compétences</a></li>
                    <li class="nav-items"><a href="" data-i18n="nav_ipsum">Expedita!</a></li>
                    <li class="nav-items"><a href="" data-i18n="nav_dolor">Libero.</a></li>
                {% if app.user %}
                    <li class="nav-items"><a href="{{ path('app_logout') }}" class="menu-items" data-i18n="nav_disconnect">Se déconnecter</a></li>
                {% else %}
                    <li class="nav-items"><a href="{{ path('create_user') }}" class="menu-items" data-i18n="nav_register">S'inscrire</a></li>
                    <li class="nav-items"><a href="{{ path('app_login') }}" class="menu-items" data-i18n="nav_connect">Se connecter</a></li>
                {% endif %}
                </ul>
                
                <!-- Sélecteur de langue -->
                <div class="lang-switcher">
                    <button class="lang-toggle">Français ⌄</button>
                    <ul class="lang-options">
                        <li data-lang="fr">Français</li>
                        <li data-lang="en">English</li>
                    </ul>
                </div>
            </nav>
        </header>
        
        <main>
            {% block body %}{% endblock %}
        </main>
        
        <footer class="footer">
            <div class="footer-container">
                <div class="footer-content">
                    <!-- Section À propos -->
                    <div class="footer-section footer-about">
                        <div class="footer-logo">
                            <div class="footer-flag">
                                <div class="flag-stripe flag-stripe--blue"></div>
                                <div class="flag-stripe flag-stripe--white"></div>
                                <div class="flag-stripe flag-stripe--red"></div>
                            </div>
                            <span class="footer-logo-text" data-i18n="footer_logo">République</span>
                        </div>
                        <p data-i18n="footer_description">
                            Plateforme d'apprentissage des valeurs et principes de la République française. 
                            Découvrez, apprenez et testez vos connaissances sur notre démocratie.
                        </p>
                    </div>
                    
                    <!-- Section Navigation -->
                    <div class="footer-section footer-nav">
                        <h3 data-i18n="footer_nav_title">Navigation</h3>
                        <ul>
                            <li><a href="{{ path('home') }}" data-i18n="footer_nav_home">Accueil</a></li>
                            <li><a href="{{ path('mini_games') }}" data-i18n="footer_nav_games">Mini-jeux</a></li>
                            <li><a href="#" data-i18n="footer_nav_about">À propos</a></li>
                            <li><a href="#" data-i18n="footer_nav_help">Aide</a></li>
                        </ul>
                    </div>
                    
                    <!-- Section Contact -->
                    <div class="footer-section footer-contact">
                        <h3 data-i18n="footer_contact_title">Contact</h3>
                        <div class="contact-info">
                            <div class="contact-item">
                                <i class="fas fa-envelope"></i>
                                <a href="mailto:contact@republique.fr">contact@republique.fr</a>
                            </div>
                            <div class="contact-item">
                                <i class="fas fa-phone"></i>
                                <span>01 23 45 67 89</span>
                            </div>
                            <div class="contact-item">
                                <i class="fas fa-map-marker-alt"></i>
                                <span data-i18n="footer_address">Paris, France</span>
                            </div>
                        </div>
                        
                        <div class="footer-social">
                            <div class="social-links">
                                <a href="#" title="Facebook" aria-label="Facebook">
                                    <i class="fab fa-facebook-f"></i>
                                </a>
                                <a href="#" title="Twitter" aria-label="Twitter">
                                    <i class="fab fa-twitter"></i>
                                </a>
                                <a href="#" title="LinkedIn" aria-label="LinkedIn">
                                    <i class="fab fa-linkedin-in"></i>
                                </a>
                                <a href="#" title="YouTube" aria-label="YouTube">
                                    <i class="fab fa-youtube"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="footer-bottom">
                    <div class="footer-copyright">
                        <span data-i18n="footer_copyright">© 2025 République.</span> 
                        <span data-i18n="footer_rights">Tous droits réservés.</span>
                    </div>
                    <div class="footer-links">
                        <a href="#" data-i18n="footer_privacy">Confidentialité</a>
                        <a href="#" data-i18n="footer_terms">Conditions</a>
                        <a href="#" data-i18n="footer_legal">Mentions légales</a>
                    </div>
                </div>
            </div>
        </footer>
    </body>
</html>