{% extends 'base.html.twig' %}

{% block title %}Mini-jeux République{% endblock %}

{% block body %}
<div class="minigames-container">
    <div class="minigames">
        <!-- Jeu 1: Glisser-déposer -->
        <section class="game-section drag-drop-game">
            <div class="game-header">
                <h1 data-i18n="minigames_1_title"></h1>
                <h3 data-i18n="minigames_1_subtitle"></h3>
                <p data-i18n="minigames_1_desc"></p>
            </div>
            
            <div class="game-content">
                <div id="game">
                    <div class="words-section">
                        <strong data-i18n="minigames_1_label"></strong>
                        <div id="words"></div>
                    </div>
                    
                    <div class="definitions-section">
                        <strong data-i18n="minigames_1_def_label"></strong>
                        <div id="definitions"></div>
                    </div>
                    
                    <div class="game-result">
                        <div id="result"></div>
                        <button id="restart" data-i18n="minigames_1_restart"></button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Jeu 2: Vrai ou Faux -->
        <section class="game-section true-false-game">
            <div class="game-header">
                <h1 data-i18n="minigames_2_title"></h1>
                <p data-i18n="vf_choose_difficulty">Choisissez votre niveau de difficulté :</p>
            </div>
            
            <!-- Sélecteur de difficulté -->
            <div class="vf-difficulty-selector">
                <div class="vf-difficulty-buttons">
                    <button class="vf-difficulty-btn easy" data-difficulty="4">
                        <div class="difficulty-icon">📚</div>
                        <div class="difficulty-title" data-i18n="vf_easy">Facile</div>
                        <div class="difficulty-desc" data-i18n="vf_easy_desc">4 questions</div>
                    </button>
                    
                    <button class="vf-difficulty-btn medium" data-difficulty="8">
                        <div class="difficulty-icon">🎯</div>
                        <div class="difficulty-title" data-i18n="vf_medium">Moyen</div>
                        <div class="difficulty-desc" data-i18n="vf_medium_desc">8 questions</div>
                    </button>
                    
                    <button class="vf-difficulty-btn hard" data-difficulty="10">
                        <div class="difficulty-icon">🏆</div>
                        <div class="difficulty-title" data-i18n="vf_hard">Difficile</div>
                        <div class="difficulty-desc" data-i18n="vf_hard_desc">10 questions</div>
                    </button>
                </div>
            </div>
            
            <!-- Contenu du jeu (caché au début) -->
            <div class="vf-game-content" style="display: none;">
                <div class="question-container">
                    <div id="vf-progress"></div>
                    <div id="vf-question"></div>
                </div>
                
                <div class="score-display">
                    <div id="vf-score"></div>
                </div>
                
                <div class="answer-buttons">
                    <button id="vf-true" data-i18n="minigames_2_true"></button>
                    <button id="vf-false" data-i18n="minigames_2_false"></button>
                </div>
                
                <div class="feedback-container">
                    <div id="vf-feedback"></div>
                    <button id="vf-next" data-i18n="minigames_2_next"></button>
                </div>
            </div>
        </section>
    </div>
</div>
{% endblock %}