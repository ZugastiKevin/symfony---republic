{% extends 'base.html.twig' %}

{% block title %}{{ quiz.name }}{% endblock %}

{% block body %}
    <section id="quiz">
        <div class="container quiz">
            <div class="quiz-title">
                <h2>{{ quiz.name }}</h2>
            </div>
            <div class="quiz-content">
                <p>{{ quiz.synopsys }}</p>
            </div>
            <div class="quiz-option">
                {% if app.user %}
                    <div class="game-quiz">
                        <a href="{{ path('update_quiz',{'id' : quiz.id}) }}">Rejoindre la partie multijoueur</a>
                        <a href="{{ path('update_quiz',{'id' : quiz.id}) }}">Defier le quiz</a>
                    </div>
                {% endif %}
                {% if app.user and app.user.id == quiz.user.id %}
                    <div class="option">
                        <a href="{{ path('update_quiz',{'id' : quiz.id}) }}">Modifier</a>
                        <form method="POST" onsubmit="return confirm('Confirmer la suppression?')" action="{{ path('delete_quiz', {'id': quiz.id}) }}">
                            <input type="hidden" name="_method" value="delete">
                            <input type="hidden" name="_token" value="{{ csrf_token('SUP' ~ quiz.id) }}">
                            <input type="submit" value="Supprimer">
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
