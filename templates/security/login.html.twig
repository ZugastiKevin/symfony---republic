{% extends 'base.html.twig' %}

{% block title %}Connexion - République{% endblock %}

{% block body %}
<div class="login-page">
    <div class="login-container">
        <div class="login-header">
            <h1 data-i18n="login_title">Connexion</h1>
            <p data-i18n="login_subtitle">Accédez à votre espace République</p>
        </div>

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="alert">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </div>
        {% endif %}

        <form method="post">
            <div class="form-group">
                <label for="username" data-i18n="login_email">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus placeholder="votre@email.fr">
            </div>

            <div class="form-group">
                <label for="password" data-i18n="login_password">Mot de passe</label>
                <input type="password" name="_password" id="password" autocomplete="current-password" required placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="login-button" type="submit" data-i18n="login_submit">
                Se connecter
            </button>
        </form>

        <div class="login-footer">
            <p data-i18n="login_no_account">Pas encore de compte ?</p>
            <a href="{{ path('create_user') }}" data-i18n="login_register_link">Créer un compte</a>
        </div>
    </div>
</div>
{% endblock %}